{
  "name": "multiterminal",
  "version": "0.2.0",
  "description": "A control room for many terminals and AI coding CLIs: one pane per project, per-pane status, and one prompt box that targets exactly the terminals you pick.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "dev.multiterminal.app",
    "productName": "multiTerminal",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "templates/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
